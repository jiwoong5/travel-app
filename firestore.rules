rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(groupId) {
      return request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);
      allow delete: if request.auth.uid == resource.data.createdBy;

      match /members/{userId} {
        allow read: if isMember(groupId);
        allow write: if request.auth.uid == userId;
      }

      match /votes/{voteId} {
        allow read: if isMember(groupId);
        allow create, update: if isMember(groupId);
        allow delete: if request.auth.uid == resource.data.createdBy;

        match /options/{optionId} {
          allow read: if isMember(groupId);
          allow write: if isMember(groupId);
        }

        match /records/{userId} {
          allow read: if isMember(groupId);
          allow create, update: if request.auth.uid == userId && isMember(groupId);
        }
      }

      match /trips/{tripId} {
        allow read: if isMember(groupId);
        allow write: if isMember(groupId);

        match /items/{itemId} {
          allow read: if isMember(groupId);
          allow write: if isMember(groupId);
        }
      }

      match /albums/{albumId} {
        allow read: if isMember(groupId);
        allow write: if isMember(groupId);

        match /photos/{photoId} {
          allow read: if isMember(groupId);
          allow write: if isMember(groupId);

          match /comments/{commentId} {
            allow read: if isMember(groupId);
            allow create: if isMember(groupId);
            allow delete: if request.auth.uid == resource.data.userId;
          }
        }
      }
    }
  }
}
